{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["quadlet"],
  "packageRules": [
    {
      "description": "Database majors need a dump and restore, so bump them by hand",
      "matchPackageNames": ["/postgres/", "/pgvector/", "/postgis/", "/redis/", "/valkey/"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Immich server and machine-learning must run the same version",
      "matchPackageNames": ["ghcr.io/immich-app/immich-server", "ghcr.io/immich-app/immich-machine-learning"],
      "groupName": "immich"
    }
  ]
}
