[Unit]
Requires=hindsight-postgres.service
After=hindsight-postgres.service

[Container]
ContainerName=hindsight
Image=ghcr.io/vectorize-io/hindsight:1.1.0
Network=skynet.network
PublishPort=8888:8888
PublishPort=127.0.0.1:9999:9999
Environment=HINDSIGHT_API_LLM_PROVIDER=anthropic HINDSIGHT_API_LLM_MODEL=claude-haiku-5-5
Environment=HINDSIGHT_API_TENANT_EXTENSION=hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension
Secret=hindsight_api_key,type=env,target=HINDSIGHT_API_TENANT_API_KEY
Secret=hindsight_api_key,type=env,target=HINDSIGHT_CP_DATAPLANE_API_KEY
Secret=hindsight_db_url,type=env,target=HINDSIGHT_API_DATABASE_URL
Secret=anthropic_api_key,type=env,target=HINDSIGHT_API_LLM_API_KEY

[Service]
Restart=always
TimeoutStartSec=600

[Install]
WantedBy=default.target
