[Container]
ContainerName=gatus
# no release tag matches the running build, so this follows latest by digest
Image=docker.io/twinproduction/gatus:latest@sha256:b542b3d006eab3320ed6354eaa4a70e005f49c69e14b8f15157ab00d4b8a5703
Network=skynet.network
Network=karakeep.network
Volume=%h/.config/homelab/gatus:/config:ro,Z
Volume=%h/.local/share/homelab/gatus:/data:Z
Environment=GATUS_CONFIG_PATH=/config/config.yaml
Secret=gatus_ntfy_topic,type=env,target=NTFY_TOPIC

[Service]
Restart=always

[Install]
WantedBy=default.target
