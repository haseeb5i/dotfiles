[Unit]
Description=Karakeep Meilisearch

[Container]
ContainerName=karakeep-meilisearch
Image=docker.io/getmeili/meilisearch:v1.55.0@sha256:ff546679970126f8822e15d1b6a06bfbff1f2ce2e43f810cfb5258012f92de5c
Network=karakeep.network
Volume=%h/.local/share/homelab/karakeep/meilisearch:/meili_data:Z
Environment=MEILI_NO_ANALYTICS=true
Secret=karakeep_meili_master_key,type=env,target=MEILI_MASTER_KEY

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
