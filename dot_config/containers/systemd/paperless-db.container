[Container]
ContainerName=paperless-db
Image=docker.io/library/postgres:17@sha256:0d938e975177bef9f1f61f3f9dbcf2e0aa0a139568f66d3415ed8892eb97f6ac
Network=skynet.network
Volume=%h/.local/share/homelab/paperless/postgres:/var/lib/postgresql/data:Z
Environment=POSTGRES_DB=paperless POSTGRES_USER=paperless
Secret=paperless_db_password,type=env,target=POSTGRES_PASSWORD

[Service]
Restart=always

[Install]
WantedBy=default.target
