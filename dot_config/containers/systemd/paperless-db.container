[Container]
ContainerName=paperless-db
Image=docker.io/library/postgres@sha256:6f7593c161689b6b02c78668b314af7da8811b592c5519108c57a49d0b6ad788
Network=skynet.network
Volume=%h/.local/share/paperless/postgres:/var/lib/postgresql/data:Z
Environment=POSTGRES_DB=paperless POSTGRES_USER=paperless
Secret=paperless_db_password,type=env,target=POSTGRES_PASSWORD

[Service]
Restart=always

[Install]
WantedBy=default.target
