[Container]
ContainerName=immich-postgres
Image=ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0
Network=skynet.network
Volume=%h/.local/share/immich/postgres:/var/lib/postgresql/data:Z
Environment=POSTGRES_USER=postgres POSTGRES_DB=immich POSTGRES_INITDB_ARGS=--data-checksums
Secret=immich_db_password,type=env,target=POSTGRES_PASSWORD
ShmSize=128m

[Service]
Restart=always

[Install]
WantedBy=default.target
