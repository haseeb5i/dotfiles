[Container]
ContainerName=mealie
Image=ghcr.io/mealie-recipes/mealie@sha256:e0c056e730122abd92e611af811c29bbad94c6018572180369cd9f3797e49a05
Network=skynet.network
PublishPort=127.0.0.1:9085:9000
Volume=%h/.local/share/mealie/data:/app/data:Z
Environment=BASE_URL=https://meals.ravennest.link ALLOW_SIGNUP=false TZ=America/Los_Angeles
Environment=HOST_IP=10.89.0.1

[Service]
Restart=always
TimeoutStartSec=1800

[Install]
WantedBy=default.target
