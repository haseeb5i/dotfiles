[Container]
ContainerName=actual
Image=docker.io/actualbudget/actual-server:latest
Network=skynet.network
Volume=%h/.local/share/actual:/data:Z
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=300
# node exits 143 on SIGTERM, which the nightly backup sends
SuccessExitStatus=143

[Install]
WantedBy=default.target
