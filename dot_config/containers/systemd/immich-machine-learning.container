[Container]
ContainerName=immich-machine-learning
Image=ghcr.io/immich-app/immich-machine-learning:v3.4.1-openvino@sha256:97f60b06c5938c326d3ba416bcf24bc94d233f34554c05f3b76336f98ffd5ea9
# Intel iGPU through WSL, as in the openvino-wsl block of hwaccel.ml.yml
AddDevice=/dev/dxg
Volume=/usr/lib/wsl:/usr/lib/wsl:ro
Network=skynet.network
Volume=%h/.cache/homelab/immich-ml:/cache:Z
Environment=TZ=Asia/Karachi MACHINE_LEARNING_MODEL_REVISION=v2
[Service]
Restart=always
TimeoutStartSec=600
[Install]
WantedBy=default.target
