[Container]
ContainerName=freshrss
Image=docker.io/freshrss/freshrss:1.30.4@sha256:af44385229541bee24aa9148d0ff8f3b40e095373c63a2c0f74e09a27d3c59df
Network=skynet.network
Volume=%h/.local/share/homelab/freshrss/data:/var/www/FreshRSS/data:Z
Volume=%h/.local/share/homelab/freshrss/extensions:/var/www/FreshRSS/extensions:Z
Environment=TZ=Asia/Karachi CRON_MIN=2
# sso through authelia for the web ui (/i/); /api/ keeps the api password for rss apps
Environment=OIDC_ENABLED=1 OIDC_PROVIDER_METADATA_URL=https://auth.ravennest.link/.well-known/openid-configuration OIDC_CLIENT_ID=freshrss
Environment=OIDC_REMOTE_USER_CLAIM=preferred_username "OIDC_SCOPES=openid groups email profile" OIDC_X_FORWARDED_HEADERS=X-Forwarded-Proto
Secret=oidc_freshrss,type=env,target=OIDC_CLIENT_SECRET
Secret=freshrss_oidc_crypto,type=env,target=OIDC_CLIENT_CRYPTO_KEY

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
