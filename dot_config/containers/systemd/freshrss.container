[Container]
ContainerName=freshrss
Image=docker.io/freshrss/freshrss:1.30.4@sha256:af44385229541bee24aa9148d0ff8f3b40e095373c63a2c0f74e09a27d3c59df
Network=skynet.network
Volume=%h/.local/share/homelab/freshrss/data:/var/www/FreshRSS/data:Z
Volume=%h/.local/share/homelab/freshrss/extensions:/var/www/FreshRSS/extensions:Z
Environment=TZ=Asia/Karachi CRON_MIN=2

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
