[Container]
ContainerName=authelia
Image=docker.io/authelia/authelia:4.39.28@sha256:a9931f4443882fcc43bc368bffd40b51ff1867045d46c8dc2e87fb2b03a32178
Network=skynet.network
# the folder, not the file: chezmoi replaces the file on apply and a single-file mount keeps the old one
Volume=%h/.config/homelab/authelia:/etc/authelia:ro,Z
Volume=%h/.local/share/homelab/authelia:/config:Z
Secret=authelia_jwt
Secret=authelia_session
Secret=authelia_storage
Secret=authelia_oidc_hmac
Secret=authelia_oidc_jwk
Secret=resend_api_key
Secret=oidc_cloudflare_digest
Secret=oidc_paperless_digest
Secret=oidc_karakeep_digest
Secret=oidc_adventurelog_digest
Secret=oidc_actual_digest
Secret=oidc_freshrss_digest
Environment=X_AUTHELIA_CONFIG=/etc/authelia/configuration.yml X_AUTHELIA_CONFIG_FILTERS=template
Environment=AUTHELIA_IDENTITY_PROVIDERS_OIDC_HMAC_SECRET_FILE=/run/secrets/authelia_oidc_hmac
Environment=AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET_FILE=/run/secrets/authelia_jwt
Environment=AUTHELIA_NOTIFIER_SMTP_PASSWORD_FILE=/run/secrets/resend_api_key
Environment=AUTHELIA_SESSION_SECRET_FILE=/run/secrets/authelia_session
Environment=AUTHELIA_STORAGE_ENCRYPTION_KEY_FILE=/run/secrets/authelia_storage

[Service]
Restart=always

[Install]
WantedBy=default.target
