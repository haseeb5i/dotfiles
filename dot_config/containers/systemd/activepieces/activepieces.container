[Unit]
Requires=activepieces-postgres.service activepieces-redis.service
After=activepieces-postgres.service activepieces-redis.service

[Container]
ContainerName=activepieces
# pinned: bump by hand after reading the release notes, migrations change the db
Image=ghcr.io/activepieces/activepieces:0.92.3-hotfix.1
Network=skynet.network
Volume=%h/.local/share/activepieces/cache:/usr/src/app/cache:Z
# app and worker in one container (the image default); a separate worker would reach the app through caddy
Environment=AP_POSTGRES_HOST=activepieces-postgres AP_POSTGRES_PORT=5432 AP_POSTGRES_DATABASE=activepieces AP_POSTGRES_USERNAME=activepieces
Environment=AP_REDIS_HOST=activepieces-redis AP_REDIS_PORT=6379
Environment=AP_FRONTEND_URL=https://flows.haseeb5i.duckdns.org AP_ENVIRONMENT=prod AP_EXECUTION_MODE=UNSANDBOXED AP_TELEMETRY_ENABLED=false
Secret=ap_db_password,type=env,target=AP_POSTGRES_PASSWORD
Secret=ap_redis_password,type=env,target=AP_REDIS_PASSWORD
Secret=ap_encryption_key,type=env,target=AP_ENCRYPTION_KEY
Secret=ap_jwt_secret,type=env,target=AP_JWT_SECRET

[Service]
Restart=always
TimeoutStartSec=600
# the entrypoint exits 1 after it stops the app and worker on SIGTERM
SuccessExitStatus=1

[Install]
WantedBy=default.target
