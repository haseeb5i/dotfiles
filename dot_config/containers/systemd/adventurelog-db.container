[Container]
ContainerName=adventurelog-db
Image=docker.io/imresamu/postgis:16-3.5-alpine@sha256:367f65cee655c1cc7ac2ed17b0c77ca516ab8634c53698eda4a799f23a575e89
Network=skynet.network
Volume=%h/.local/share/homelab/adventurelog/postgres:/var/lib/postgresql/data:Z
Environment=POSTGRES_DB=database POSTGRES_USER=adventure
Secret=adventurelog_db_password,type=env,target=POSTGRES_PASSWORD

[Service]
Restart=always

[Install]
WantedBy=default.target
