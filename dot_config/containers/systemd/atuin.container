[Unit]
Description=Atuin self-hosted sync server

[Container]
Image=ghcr.io/atuinsh/atuin:18.24.8@sha256:dc9a70c0c8c3500ec978851d44e7156f2f8d4a5c556b537c86be7b9c6629174f
ContainerName=atuin
Network=skynet.network
PublishPort=127.0.0.1:9087:8888
Volume=%h/.local/share/atuin:/config:Z
Environment=ATUIN_HOST=0.0.0.0
Environment=ATUIN_PORT=8888
Environment=ATUIN_OPEN_REGISTRATION=false
Environment=ATUIN_DB_URI=sqlite:///config/atuin.db
Exec=start

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
