[Container]
ContainerName=blinko-postgres
Image=docker.io/library/postgres:17
Network=skynet.network
Volume=%h/.local/share/blinko/postgres:/var/lib/postgresql/data:Z
Environment=POSTGRES_DB=postgres POSTGRES_USER=postgres
Secret=blinko_db_password,type=env,target=POSTGRES_PASSWORD
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
