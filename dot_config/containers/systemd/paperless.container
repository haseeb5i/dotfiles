[Unit]
Requires=paperless-db.service paperless-valkey.service
After=paperless-db.service paperless-valkey.service

[Container]
ContainerName=paperless
Image=ghcr.io/paperless-ngx/paperless-ngx@sha256:1856adaeccf1a3bfc58722767321888ee6ecbeeb7807ae5b0836d0f0a4ce3f25
Network=skynet.network
PublishPort=127.0.0.1:9084:8000
Volume=%h/.local/share/paperless/data:/usr/src/paperless/data:Z
Volume=%h/.local/share/paperless/media:/usr/src/paperless/media:Z
Volume=%h/.local/share/paperless/consume:/usr/src/paperless/consume:Z
Volume=%h/.local/share/paperless/export:/usr/src/paperless/export:Z
Environment=PAPERLESS_URL=https://docs.ravennest.link PAPERLESS_DBENGINE=postgresql PAPERLESS_DBHOST=paperless-db PAPERLESS_DBNAME=paperless PAPERLESS_DBUSER=paperless PAPERLESS_REDIS=redis://paperless-valkey:6379
Environment=PAPERLESS_TIME_ZONE=America/Los_Angeles PAPERLESS_ADMIN_USER=raven PAPERLESS_ADMIN_MAIL=raven@localhost
Secret=paperless_db_password,type=env,target=PAPERLESS_DBPASS
Secret=paperless_signing_key,type=env,target=PAPERLESS_SECRET_KEY
Secret=paperless_admin_password,type=env,target=PAPERLESS_ADMIN_PASSWORD

[Service]
Restart=always
TimeoutStartSec=1800

[Install]
WantedBy=default.target
