[Container]
ContainerName=actual
Image=docker.io/actualbudget/actual-server@sha256:c56adb686c5b72d755a4958905a27212edc6be27d065ebe3cb470c95c552df89
Network=skynet.network
PublishPort=127.0.0.1:9083:5006
Volume=%h/.local/share/actual:/data:Z
Environment=ACTUAL_ALLOWED_LOGIN_METHODS=password

[Service]
Restart=always
TimeoutStartSec=300
SuccessExitStatus=143

[Install]
WantedBy=default.target
