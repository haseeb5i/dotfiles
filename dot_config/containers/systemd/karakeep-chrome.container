[Unit]
Description=Karakeep browser

[Container]
ContainerName=karakeep-chrome
Image=ghcr.io/karakeep-app/karakeep-chrome:157.0.8103.78-r1@sha256:00fb4fa9c37aa74c58e74d0bdd16c4e3b81dddb5f264917c879f9579c3b3ad95
RunInit=true
Network=karakeep.network
IP=10.89.5.2
Exec=--disable-gpu --disable-dev-shm-usage --hide-scrollbars --disable-blink-features=AutomationControlled --window-size=1440,900

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
