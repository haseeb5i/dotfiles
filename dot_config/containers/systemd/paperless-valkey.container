[Container]
ContainerName=paperless-valkey
Image=docker.io/valkey/valkey:9@sha256:3add1a336a920ea54770a001ab6feb3da5fceea96a40373a3a2cd469b815f0b7
Network=skynet.network
Volume=%h/.local/share/homelab/paperless/valkey:/data:Z
Exec=valkey-server --save 60 1 --loglevel warning

[Service]
Restart=always

[Install]
WantedBy=default.target
