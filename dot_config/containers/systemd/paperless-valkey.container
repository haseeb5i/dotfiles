[Container]
ContainerName=paperless-valkey
Image=docker.io/valkey/valkey@sha256:b94f4063db6015ab2fd39a764c241a107aa176c5e7801742af81f4f8f3cb532a
Network=skynet.network
Volume=%h/.local/share/paperless/valkey:/data:Z
Exec=valkey-server --save 60 1 --loglevel warning

[Service]
Restart=always

[Install]
WantedBy=default.target
