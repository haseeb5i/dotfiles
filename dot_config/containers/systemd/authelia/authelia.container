[Unit]
Requires=authelia-valkey.service
After=authelia-valkey.service

[Container]
ContainerName=authelia
Image=docker.io/authelia/authelia:latest
Network=skynet.network
Volume=%h/.config/authelia:/config:Z
Volume=%h/.local/share/authelia:/data:Z
Secret=authelia_jwt
Secret=authelia_session
Secret=authelia_storage
Secret=authelia_valkey
Environment=AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET_FILE=/run/secrets/authelia_jwt
Environment=AUTHELIA_SESSION_SECRET_FILE=/run/secrets/authelia_session
Environment=AUTHELIA_STORAGE_ENCRYPTION_KEY_FILE=/run/secrets/authelia_storage
Environment=AUTHELIA_SESSION_REDIS_PASSWORD_FILE=/run/secrets/authelia_valkey
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
