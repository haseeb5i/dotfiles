[Unit]
Requires=immich-postgres.service immich-valkey.service immich-machine-learning.service
After=immich-postgres.service immich-valkey.service immich-machine-learning.service
[Container]
ContainerName=immich-server
Image=ghcr.io/immich-app/immich-server:v3.4.1@sha256:7c489add298fc2f92cda4c777de6462aa206877e04087b815f62c7664af0b53b
Network=skynet.network
PublishPort=100.67.166.24:2283:2283
# outside ~/.local/share/homelab so the nightly B2 backup skips the photo library
Volume=%h/media/photos:/data:Z
Volume=/etc/localtime:/etc/localtime:ro
Environment=TZ=Asia/Karachi DB_HOSTNAME=immich-postgres DB_USERNAME=postgres DB_DATABASE_NAME=immich
Environment=REDIS_HOSTNAME=immich-valkey
Secret=immich_db_password,type=env,target=DB_PASSWORD
[Service]
Restart=always
TimeoutStartSec=600
[Install]
WantedBy=default.target
