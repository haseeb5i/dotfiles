[Container]
ContainerName=gatus
Image=docker.io/twinproduction/gatus:latest
Network=skynet.network
Volume=%h/.config/gatus:/config:Z
Volume=%h/.local/share/gatus:/data:Z
Environment=GATUS_CONFIG_PATH=/config/config.yaml
Secret=gatus_ntfy_topic,type=env,target=NTFY_TOPIC
Secret=gatus_push_token,type=env,target=PUSH_TOKEN
Secret=resend_api_key,type=env,target=RESEND_API_KEY
# in a secret only to keep the address out of the public dotfiles repo
Secret=alert_email,type=env,target=ALERT_EMAIL
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
