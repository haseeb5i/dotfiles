[Container]
ContainerName=immich-public-proxy
Image=docker.io/alangrainger/immich-public-proxy:4.2.0@sha256:ebf84972652c4cf5a7ef7d2359db35ddca46a5cf17714975abf5a8674b05935d
Network=skynet.network
Environment=PUBLIC_BASE_URL=https://share.ravennest.link IMMICH_URL=http://immich-server:2283
# public without Access, so keep the upstream compose hardening
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
