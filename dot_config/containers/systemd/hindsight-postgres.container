[Container]
ContainerName=hindsight-postgres
Image=docker.io/pgvector/pgvector:pg18@sha256:38681dc6eaf55308e2a4c6de392d131652dcfac70e1263e35cd9b5ea3fe39782
Network=skynet.network
# parallel queries (bank clone) need more than the 64m default
ShmSize=1g
Volume=%h/.local/share/homelab/hindsight/postgres:/var/lib/postgresql:Z
Environment=POSTGRES_DB=hindsight POSTGRES_USER=hindsight
Secret=hindsight_db_password,type=env,target=POSTGRES_PASSWORD

[Service]
Restart=always

[Install]
WantedBy=default.target
