[Unit]
Description=Cloudflare Tunnel connector (WSL)
Wants=network-online.target
After=network-online.target

[Container]
Image=docker.io/cloudflare/cloudflared@sha256:b94b96edf2c9c4360f8879c8580cfaa99077f19c849ec595ca2f711b27d4f344
ContainerName=cloudflared-wsl
Network=host
UserNS=keep-id
User=0
Volume=%h/.config/homelab/cloudflared/config.yml:/etc/cloudflared/config.yml:ro,Z
Volume=%h/.config/homelab/private/cloudflared/wsl.json:/etc/cloudflared/wsl.json:ro,Z
Exec=tunnel --no-autoupdate --config /etc/cloudflared/config.yml run

[Service]
Restart=always
TimeoutStartSec=0

[Install]
WantedBy=default.target
