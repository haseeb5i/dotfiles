[Container]
ContainerName=jellyfin
Image=docker.io/jellyfin/jellyfin:12.4@sha256:fea863d0cd9ec445985d9c75fc6ed64e38a1d2766cf0c250a33d553f4fc1b771
Network=skynet.network
# tailnet only, same address as atuin.container
PublishPort=100.67.166.24:8096:8096
Volume=%h/.local/share/homelab/jellyfin/config:/config:Z
Volume=%h/.cache/homelab/jellyfin:/cache:Z
# no :Z on media, it is shared with other processes
Volume=%h/media/movies:/media/movies:ro
Volume=%h/media/shows:/media/shows:ro
Environment=TZ=Asia/Karachi

[Service]
Restart=always
TimeoutStartSec=300
# jellyfin exits 143 on SIGTERM
SuccessExitStatus=0 143

[Install]
WantedBy=default.target
