{
  // Appearance
  "buffer_font_family": "FiraCode Nerd Font",
  "agent_buffer_font_size": 15.0,
  "buffer_font_size": 17.0,
  "git_commit_buffer_font_size": 15.0,
  "ui_font_size": 18.0,
  "cli_default_open_behavior": "new_window",
  "theme": {
    "light": "Flexoki Light",
    "dark": "Gruvbox Dark",
  },

  // Editor
  "format_on_save": "off",
  "scrollbar": { "show": "never" },
  "toolbar": {
    "quick_actions": false,
  },
  "use_smartcase_search": true,

  // Panels
  "project_panel": { "dock": "left" },
  "outline_panel": { "dock": "left" },
  "collaboration_panel": { "dock": "left" },
  "git_panel": { "dock": "left" },

  // Vim
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "vertical_scroll_margin": 4,
  "tab_size": 2,
  "which_key": {
    "enabled": true,
    "delay_ms": 250,
  },

  // Git
  "git": {
    "inline_blame": { "enabled": false },
  },

  // Terminal
  "terminal": { "line_height": "comfortable" },

  // Language servers
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": { "enabled": "always" },
        },
        "javascript": {
          "updateImportsOnFileMove": { "enabled": "always" },
        },
      },
      "enable_lsp_tasks": true,
    },
  },

  // Extensions
  "auto_install_extensions": {
    "html": true,
    "prisma": true,
    "sql": true,
  },

  // AI: agent panel
  "disable_ai": false,
  "agent": {
    "dock": "right",
    "threads_sidebar": { "position": "right" },
    "expand_edit_card": false,
    "expand_terminal_card": false,
    "sandbox_permissions": {
      "allow_unsandboxed": true,
    },
  },
  "agent_servers": {
    "claude-acp": { "type": "registry" },
  },
  "context_servers": {},
  "edit_predictions": {
    "mode": "subtle",
  },
  "language_models": {},

  // Telemetry
  "telemetry": { "metrics": false },
}
