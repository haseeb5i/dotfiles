[
  {
    // Leader keys: normal/visual in editors, plus panels and empty panes
    "context": "(Editor && (vim_mode == normal || vim_mode == visual) && !menu) || (!Editor && !Terminal)",
    "bindings": {
      "space space": "file_finder::Toggle",
      "space ,": "tab_switcher::Toggle",
      "space /": "pane::DeploySearch",
      "space `": "pane::AlternateFile",
      "space e": "project_panel::Toggle",

      // Splits, Windows & Docks
      "space -": "pane::SplitDown",
      "space |": "pane::SplitRight",
      "space w m": "workspace::ToggleZoom",
      "space w h": "workspace::ToggleLeftDock",
      "space w l": "workspace::ToggleRightDock",
      "space w j": "workspace::ToggleBottomDock",

      // File Operations
      "space f p": "projects::OpenRecent",
      "space f e": "pane::RevealInProjectPanel",
      "space f n": "workspace::NewFile",
      "space f t": "workspace::NewTerminal",

      // Search
      "space s k": "zed::OpenKeymap",
      "space s r": ["pane::DeploySearch", { "replace_enabled": true }],
      "space s s": "outline::Toggle",
      "space s shift-s": "project_symbols::Toggle",
      "space s shift-r": "workspace::ReopenLastPicker",

      // Buffers & Tabs
      "space b d": "pane::CloseActiveItem",
      "space b o": "pane::CloseOtherItems",
      "space b p": "pane::TogglePinTab",
      "space b shift-p": ["pane::CloseAllItems", { "close_pinned": false }],

      // Code
      "space c f": "editor::Format",
      "space c s": "outline_panel::Toggle",
      "space c o": "editor::OrganizeImports",
      "space x x": "diagnostics::Deploy",

      // Git
      "space g x": "git::Branch",
      "space g b": "editor::BlameHover",
      "space g g": "git_panel::Toggle",
      "space g d": "git::Diff",
      "space g f": "git::FileHistory",
      "space g shift-b": "editor::OpenPermalinkToLine",
      "space g shift-y": "editor::CopyPermalinkToLine",
      "space g h shift-b": "git::Blame",
      "space g h shift-r": "git::RestoreFile",
      "space g h shift-s": "git::StageFile",

      // UI Toggles
      "space u w": "editor::ToggleSoftWrap",
      "space u h": "editor::ToggleInlayHints",
      "space u b": "theme::ToggleMode",
      "space u z": "workspace::ToggleCenteredLayout",
      "space u d": "editor::ToggleDiagnostics",

      // Misc
      "space a c": "agent::Toggle",
      "space m p": "markdown::OpenPreview",
      "space m shift-p": "markdown::OpenPreviewToTheSide",
    },
  },
  {
    "context": "Editor && vim_mode == normal && !menu",
    "bindings": {
      // Buffers & Tabs
      "shift-h": "pane::ActivatePreviousItem",
      "shift-l": "pane::ActivateNextItem",
      "alt-h": "pane::SwapItemLeft",
      "alt-l": "pane::SwapItemRight",

      // LSP Verbs
      "g shift-k": "editor::ShowSignatureHelp",

      // Diagnostics Navigation
      "] e": ["editor::GoToDiagnostic", { "severity": "error" }],
      "[ e": ["editor::GoToPreviousDiagnostic", { "severity": "error" }],
      "] w": ["editor::GoToDiagnostic", { "severity": "warning" }],
      "[ w": ["editor::GoToPreviousDiagnostic", { "severity": "warning" }],
    },
  },
  {
    "context": "Editor && VimControl && !menu",
    "bindings": {
      "] f": "vim::NextMethodStart",
      "[ f": "vim::PreviousMethodStart",
      "] shift-f": "vim::NextMethodEnd",
      "[ shift-f": "vim::PreviousMethodEnd",

      "p": ["vim::Paste", { "preserve_clipboard": true }],
    },
  },
  {
    "context": "Editor && (VimControl || vim_mode == insert) && !menu",
    "bindings": {
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",
    },
  },
  {
    "context": "Editor && vim_mode == insert && !menu",
    "bindings": {
      "j k": "vim::NormalBefore",
      "ctrl-e": "vim::EndOfLine",
      "ctrl-b": "vim::StartOfLine",
      "ctrl-k": "editor::ShowSignatureHelp",
    },
  },
  {
    "context": "Editor && showing_completions",
    "bindings": {
      "ctrl-e": "editor::Cancel",
      "ctrl-y": "editor::ConfirmCompletion",
    },
  },
  {
    "context": "vim_operator == a || vim_operator == i || vim_operator == cs",
    "bindings": {
      "b": "vim::MiniBrackets",
      "g": "vim::EntireFile",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": "project_panel::Delete",
      "x": "project_panel::Cut",
      "c": "project_panel::Copy",
      "p": "project_panel::Paste",
      "o": "workspace::OpenWithSystem",
      "backspace": "project_panel::SelectParent",
      "y": "workspace::CopyPath",
      "shift-y": "workspace::CopyRelativePath",
    },
  },
  {
    // Move between splits, docks and the terminal
    "context": "(Editor && vim_mode == normal && !menu) || Terminal || Dock",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
    },
  },
  {
    "context": "Workspace || Editor || Terminal",
    "bindings": {
      "ctrl-\\": "terminal_panel::Toggle",
    },
  },
  {
    // Give shell history/fzf keys back to the terminal (Zed's workspace defaults take them)
    "context": "Terminal",
    "bindings": {
      "ctrl-p": ["terminal::SendKeystroke", "ctrl-p"],
      "ctrl-n": ["terminal::SendKeystroke", "ctrl-n"],
      "ctrl-t": ["terminal::SendKeystroke", "ctrl-t"],
    },
  },
]
