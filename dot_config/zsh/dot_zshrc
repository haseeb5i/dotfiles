HISTFILE=${ZDOTDIR:-$HOME}/.zsh_history

# Keep completion state out of the config dir. Must be set before zim's
# completion module runs compinit.
zstyle ':zim:completion' dumpfile "${XDG_CACHE_HOME}/zsh/zcompdump"
zstyle ':completion::complete:*' cache-path "${XDG_CACHE_HOME}/zsh/zcompcache"

fpath=(
  $XDG_DATA_HOME/{zsh/site-functions,mise-completions/zsh}(N)
  $fpath
)

bindkey -v
WORDCHARS=${WORDCHARS//[\/]}
KEYTIMEOUT=10

# Disable automatic widget re-binding on each precmd. This can be set when
# zsh-users/zsh-autosuggestions is the last module in your ~/.zimrc.
ZSH_AUTOSUGGEST_MANUAL_REBIND=1

zstyle ':zim:input' double-dot-expand yes

ZIM_HOME=${ZDOTDIR}/.zim
if [[ ! -e ${ZIM_HOME}/zimfw.zsh ]]; then
  curl -fsSL --create-dirs -o ${ZIM_HOME}/zimfw.zsh \
    https://github.com/zimfw/zimfw/releases/latest/download/zimfw.zsh
fi
if [[ ! ${ZIM_HOME}/init.zsh -nt ${ZIM_CONFIG_FILE:-${ZDOTDIR}/.zimrc} ]]; then
  source ${ZIM_HOME}/zimfw.zsh init
fi
source ${ZIM_HOME}/init.zsh

setopt HIST_IGNORE_ALL_DUPS HIST_FCNTL_LOCK

# Completion styles (after zim's completion module so these win).
zstyle ':completion:*:git-checkout:*' sort false
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' menu no
zstyle ':completion:*:*:cd:*:directory-stack' menu no
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
zstyle ':fzf-tab:*' switch-group '<' '>'

alias ..='cd ..'
alias ...='cd ../..'
alias grep='grep --color=auto'
alias cat='bat --paging=never'
alias ls='eza --icons=auto'
alias lx='eza -lah --icons --git --sort=extension'
alias tree='eza --tree --icons'
alias lg='lazygit'

bindkey '^p' history-search-backward
bindkey '^n' history-search-forward
bindkey '^[l' autosuggest-accept
bindkey '^[f' forward-word

# fzf: Ctrl-R history, Ctrl-T files, Alt-C cd. Binds viins/vicmd too, so this is
# correct under `bindkey -v`. Independent of fzf-tab.
if (( ${+commands[fzf]} )); then
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:200 {}'"
  export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
  export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --color=always {}'"
  source <(fzf --zsh)
fi

(( ${+commands[mise]} )) && eval "$(mise activate zsh)"

(( ${+commands[zoxide]} )) && eval "$(zoxide init --cmd cd zsh)"

(( ${+commands[starship]} )) && eval "$(starship init zsh)"

[[ -r ${ZDOTDIR}/secrets.sh ]] && source ${ZDOTDIR}/secrets.sh
