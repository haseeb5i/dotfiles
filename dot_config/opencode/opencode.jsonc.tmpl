{
  "$schema": "https://opencode.ai/config.json",
  "plugins": ["@dietrichgebert/ponytail", "@plannotator/opencode"],
  "instructions": ["~/.config/claude/instructions/code-standards.md"],
  "mcp": {
    "servers": {
      "n3o": {
        "type": "local",
        "command": ["n3o", "mcp"],
        "environment": { "DOTNET_hostBuilder__reloadConfigOnChange": "false" },
      },
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "disabled": false,
        "codemode": false
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:CONTEXT7_API_KEY}",
        },
      },
      "playwright": {
        "type": "local",
        "disabled": true,
        "command": ["npx", "-y", "@playwright/mcp@latest"],
      },
    },
  },
  "plugin": [
    "{{ .chezmoi.homeDir }}/.hindsight/coding-agents"
  ],
}
