{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "@dietrichgebert/ponytail",
    "@plannotator/opencode",
    "cc-safety-net@latest",
    "opencode-antigravity-auth@latest",
    "{env:HOME}/.hindsight/coding-agents"
  ],
  "instructions": ["~/.config/claude/instructions/code-standards.md"],
  "mcp": {
    "servers": {
      "n3o": {
        "type": "local",
        "command": ["n3o", "mcp"],
      },
      "codegraph": {
        "type": "local",
        "command": [
          "codegraph",
          "serve",
          "--mcp"
        ],
        "disabled": false,
        "codemode": false
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:CONTEXT7_API_KEY}",
        },
      },
      "logseq": {
        "type": "remote",
        "url": "http://127.0.0.1:12315/mcp",
        "oauth": false,
        "disabled": true,
        "headers": {
          "Authorization": "Bearer {env:LOGSEQ_MCP_TOKEN}",
        },
      },
    },
  }
}
