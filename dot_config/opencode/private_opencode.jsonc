{
  "$schema": "https://opencode.ai/config.json",
  "policies": [{ "action": "provider.use", "resource": "perplexity*", "effect": "deny" }],
  "plugins": [
    "@dietrichgebert/ponytail",
    "@plannotator/opencode",
    "cc-safety-net@latest",
    "opencode-antigravity-auth@latest",
    "oh-my-opencode-slim",
  ],
  "instructions": [
    "~/.config/claude/instructions/code-standards.md",
    "~/.config/claude/instructions/machines.md",
  ],
  "lsp": true,
  "websearch": { "provider": "exa" },
  "mcp": {
    "servers": {
      "n3o": {
        "type": "local",
        "command": ["n3o", "mcp"],
      },
      "codegraph": {
        "type": "local",
        "command": ["codegraph", "serve", "--mcp"],
        "disabled": false,
        "codemode": false,
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:CONTEXT7_API_KEY}",
        },
      },
    },
  },
}
