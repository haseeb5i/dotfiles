[Container]
ContainerName=actual
Image=docker.io/actualbudget/actual-server@sha256:c3ba5b1350dfa0fe18f451f735f9f3f675505e1233ac90c9ae6ee5ae9808758e
Network=skynet.network
PublishPort=127.0.0.1:9083:5006
Volume=%h/.local/share/actual:/data:Z
Environment=ACTUAL_ALLOWED_LOGIN_METHODS=password

[Service]
Restart=always
TimeoutStartSec=300
SuccessExitStatus=143

[Install]
WantedBy=default.target
