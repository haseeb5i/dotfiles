{
	acme_dns duckdns {env.DUCKDNS_TOKEN}
}

*.haseeb5i.duckdns.org {
	@auth host auth.haseeb5i.duckdns.org
	handle @auth {
		reverse_proxy authelia:9091
	}

	@glance host glance.haseeb5i.duckdns.org
	handle @glance {
		forward_auth authelia:9091 {
			uri /api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy glance:8080
	}

	@budget host budget.haseeb5i.duckdns.org
	handle @budget {
		forward_auth authelia:9091 {
			uri /api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy actual:5006
	}

	@mealie host mealie.haseeb5i.duckdns.org
	handle @mealie {
		forward_auth authelia:9091 {
			uri /api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy mealie:9000
	}
	@rss host rss.haseeb5i.duckdns.org
	handle @rss {
		# rss apps sync through the api with freshrss's own api password, they cannot pass authelia
		@rssapi path /api/*
		handle @rssapi {
			reverse_proxy freshrss:80
		}
		handle {
			forward_auth authelia:9091 {
				uri /api/authz/forward-auth
				copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
			}
			reverse_proxy freshrss:80
		}
	}
	@notes host notes.haseeb5i.duckdns.org
	handle @notes {
		forward_auth authelia:9091 {
			uri /api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy blinko:1111
	}
	@trips host trips.haseeb5i.duckdns.org
	handle @trips {
		forward_auth authelia:9091 {
			uri /api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy adventurelog:80
	}
	@flows host flows.haseeb5i.duckdns.org
	handle @flows {
		forward_auth authelia:9091 {
			uri /api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy activepieces:80
	}
	@tutor host tutor.haseeb5i.duckdns.org
	handle @tutor {
		forward_auth authelia:9091 {
			uri /api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy deeptutor:3782
	}
	# no forward_auth: agents call the api and mcp with hindsight's own api key
	@memory host memory.haseeb5i.duckdns.org
	handle @memory {
		reverse_proxy hindsight:8888
	}
	@hindsight host hindsight.haseeb5i.duckdns.org
	handle @hindsight {
		forward_auth authelia:9091 {
			uri /api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy hindsight:9999
	}
	# no forward_auth: the immich apps log in with immich's own account
	@photos host photos.haseeb5i.duckdns.org
	handle @photos {
		reverse_proxy immich-server:2283
	}
	handle {
		abort
	}
}
