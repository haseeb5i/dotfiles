[tools]
bun = "latest"
dotnet = "latest"
go = "latest"
node = "lts"
pnpm = "latest"
python = "latest"
uv = "latest"
ruby = "3.3"
rust = "latest"

usage = "latest"
"github:alltuner/mise-completions-sync" = "latest"

# harness CLIs; claude, claude-mem, opencode and plannotator stay on their own installers (self-updating)
"npm:@colbymchenry/codegraph" = "latest"
rtk = "latest"
herdr = "latest"
"github:perplexityai/perplexity-cli" = { version = "latest", bin = "pplx" }
worktrunk = { version = "latest", workflow = "release.yaml" }
oxker = "latest"
llmfit = "latest"
bitwarden = "latest"
bitwarden-secrets-manager = "latest"
1password-cli = "latest"
# python pinned: azure-cli's macOS dep pymsalruntime has no cp315 wheels yet
azure-cli = { version = "latest", python = "3.14", dependency_prereleases = "allow", with = ["pip"] }

[hooks]
postinstall = "misecompsync --shell zsh"

[settings]
idiomatic_version_file_enable_tools = ["node"]

[settings.ruby]
compile = false
