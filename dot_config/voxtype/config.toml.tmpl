[hotkey]
key = "RIGHTALT"

# voxtype 0.7.5 rejects the config without these, even at their default values
[audio]
device = "default"
sample_rate = 16000
max_duration_secs = 120

[whisper]
model = "{{ if eq .chezmoi.os "darwin" }}large-v3-turbo{{ else }}small.en{{ end }}"

[output]
mode = "type"
{{- if eq .chezmoi.os "linux" }}

[osd]
style = "default"
layout = "compact"
{{- end }}
