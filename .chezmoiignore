# Repository files and Finder metadata
AGENTS.md
README.md
renovate.json
**/.DS_Store

# Zed: keep local conversations and prompts out of chezmoi.
.config/zed/conversations/*
.config/zed/prompts/*

# Zsh: startup files only.
.config/zsh/*
!.config/zsh/.zprofile
!.config/zsh/.zshenv
!.config/zsh/.zshrc
!.config/zsh/.zimrc

# OpenCode: allow configuration files, not backups.
.config/opencode/*
!.config/opencode/cli.json
!.config/opencode/opencode.json
!.config/opencode/opencode.jsonc
!.config/opencode/oh-my-opencode-slim.json

# Claude Code: settings and the shared instructions directory.
.config/claude/*
!.config/claude/CLAUDE.md
!.config/claude/settings.json
!.config/claude/instructions

# Antigravity CLI: ignore .gemini contents except the shared config files.
.gemini/**/*
!.gemini/config
!.gemini/config/AGENTS.md
!.gemini/config/config.json
!.gemini/config/mcp_config.json
!.gemini/antigravity-cli
!.gemini/antigravity-cli/settings.json
!.gemini/antigravity-cli/statusline.py

# Linux-only configs
{{ if ne .chezmoi.os "linux" }}
.config/btop
.config/fusuma
.config/environment.d
.config/systemd
{{ end }}

# macOS-only configs
{{ if ne .chezmoi.os "darwin" }}
.config/vorssaint
Library
{{ end }}
