#!/usr/bin/env bash
# Cold backup: stop every homelab container, snapshot the data root and the podman secrets, start them again.
set -euo pipefail
umask 077
source "$HOME/.config/restic/homelab.env"

exec 9>"$XDG_RUNTIME_DIR/homelab-backup.lock"
flock -n 9 || { echo 'A homelab backup is already running' >&2; exit 1; }

units=("$HOME"/.config/containers/systemd/*.container)
units=("${units[@]##*/}")
units=("${units[@]/%.container/.service}")
mapfile -t running < <(systemctl --user list-units --state=active --plain --no-legend "${units[@]}" | cut -d' ' -f1)
apps() { ((${#running[@]} == 0)) || systemctl --user "$1" "${running[@]}"; }

finish() {
  local rc=$?
  apps start || rc=1
  if ((rc)); then
    curl -fsS -m 20 -H 'Priority: high' -d "homelab backup failed on $(</etc/hostname), exit $rc" \
      "https://ntfy.sh/$(podman secret inspect --showsecret --format '{{.SecretData}}' gatus_ntfy_topic)" >/dev/null || true
  fi
  exit "$rc"
}
trap finish EXIT

apps stop
# podman unshare: container files belong to subuids that only the user namespace can read
podman unshare restic backup --host fedora-pc --tag homelab \
  "$HOME/.local/share/homelab" "$HOME/.local/share/containers/storage/secrets"
apps start

restic forget --host fedora-pc --group-by host --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --prune
(($(date +%u) != 7)) || restic check --read-data-subset=5%
