#!/usr/bin/env bash
set -euo pipefail
umask 077
source "$HOME/.config/restic/homelab.env"

state="$HOME/.local/state/homelab-backup/dbdumps"
data="$HOME/.local/share"
mkdir -p "$state"
exec 9>"$state/backup.lock"
flock -n 9 || { echo 'A homelab backup is already running' >&2; exit 1; }

rm -f "$state/atuin.sqlite3"
podman unshare python3 -c '
import sqlite3, sys
src = sqlite3.connect(f"file:{sys.argv[1]}?mode=ro", uri=True)
dst = sqlite3.connect(sys.argv[2])
src.backup(dst)
if dst.execute("PRAGMA integrity_check").fetchone() != ("ok",):
    sys.exit("Atuin SQLite integrity check failed")
' "$data/atuin/atuin.db" "$state/atuin.sqlite3"
podman unshare cp "$data/atuin/server.toml" "$state/server.toml"

stopped=()
restart() {
  local rc=$?
  for s in "${stopped[@]}"; do
    systemctl --user start "$s.service" || { echo "Failed to restart $s.service" >&2; rc=1; }
  done
  exit "$rc"
}
trap restart EXIT
for s in karakeep paperless adventurelog activepieces activepieces-redis actual mealie freshrss logseq-sync gatus; do
  if systemctl --user is-active --quiet "$s.service"; then
    stopped=("$s" "${stopped[@]}")
    systemctl --user stop "$s.service"
  fi
done

for spec in paperless-db:paperless:paperless adventurelog-db:adventure:database activepieces-postgres:activepieces:activepieces; do
  IFS=: read -r container user db <<<"$spec"
  podman exec "$container" pg_dump -U "$user" -d "$db" -Fc > "$state/$container.dump"
  podman exec -i "$container" sh -c 'pg_restore --list; rc=$?; cat > /dev/null; exit $rc' < "$state/$container.dump" > /dev/null
done

restic backup --host fedora-pc --tag homelab \
  "$HOME/.config/restic" \
  "$data/containers/storage/secrets" \
  "$HOME/.config/homelab" \
  "$HOME/.config/containers/systemd" \
  "$state/atuin.sqlite3" "$state/server.toml" "$state"/*.dump \
  "$data/karakeep/data" \
  "$HOME/.local/bin/backup-wsl" \
  "$HOME/.config/systemd/user/backup.service" \
  "$HOME/.config/systemd/user/backup.timer"

podman unshare restic backup --host fedora-pc --tag homelab-apps \
  "$data/actual" "$data/mealie" "$data/freshrss" "$data/logseq-sync" "$data/gatus" \
  "$data/activepieces/cache" "$data/activepieces/redis" \
  "$data/paperless/data" "$data/paperless/media" "$data/paperless/consume" "$data/paperless/export" \
  "$data/adventurelog/media"
