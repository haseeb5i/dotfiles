#!/usr/bin/env bash
set -euo pipefail
umask 077
source "$HOME/.config/restic/homelab.env"
state="$HOME/.local/state/homelab-backup/dbdumps"
mkdir -p "$state"
chmod 700 "$HOME/.local/state/homelab-backup" "$state"
exec 9>"$state/backup.lock"
flock -n 9 || { echo 'A homelab backup is already running' >&2; exit 1; }
podman unshare python3 - "$HOME/.local/share/atuin/atuin.db" "$state/atuin.sqlite3" "$HOME/.local/share/atuin/server.toml" "$state/server.toml" <<'PY'
import os
import shutil
import sqlite3
import sys
source, destination, config_source, config_destination = sys.argv[1:]
temporary = destination + ".tmp"
config_temporary = config_destination + ".tmp"
try:
    with sqlite3.connect(f"file:{source}?mode=ro", uri=True) as src:
        with sqlite3.connect(temporary) as dst:
            src.backup(dst)
            if dst.execute("PRAGMA integrity_check").fetchone() != ("ok",):
                raise RuntimeError("Atuin SQLite integrity check failed")
    os.chmod(temporary, 0o600)
    os.replace(temporary, destination)
    shutil.copyfile(config_source, config_temporary)
    os.chmod(config_temporary, 0o600)
    os.replace(config_temporary, config_destination)
finally:
    for path in (temporary, config_temporary):
        if os.path.exists(path):
            os.unlink(path)
PY

# Writers stop so files and dumps agree; PostgreSQL stays online for pg_dump. Listed apps before their brokers.
writers=(karakeep paperless adventurelog activepieces activepieces-redis actual mealie freshrss logseq-sync gatus)
stopped=()
restart_writers() {
  local status=$? i
  trap - EXIT
  for ((i=${#stopped[@]}-1; i>=0; i--)); do
    if ! systemctl --user start "${stopped[$i]}.service"; then
      echo "Failed to restart previously active ${stopped[$i]}.service" >&2
      if (( status == 0 )); then
        status=1
      fi
    fi
  done
  exit "$status"
}
trap restart_writers EXIT
for service in "${writers[@]}"; do
  if systemctl --user is-active --quiet "$service.service"; then
    stopped+=("$service")
    systemctl --user stop "$service.service"
  fi
done

for spec in paperless-db:paperless:paperless adventurelog-db:adventure:database activepieces-postgres:activepieces:activepieces; do
  IFS=: read -r container user database <<<"$spec"
  podman exec "$container" pg_dump -U "$user" -d "$database" -Fc > "$state/$container.dump.tmp"
  podman exec -i "$container" sh -c 'pg_restore --list; status=$?; cat > /dev/null; exit "$status"' < "$state/$container.dump.tmp" > /dev/null
  mv "$state/$container.dump.tmp" "$state/$container.dump"
done

restic backup --host fedora-pc --tag homelab \
  "$HOME/.config/restic" \
  "$HOME/.local/share/containers/storage/secrets" \
  "$HOME/.config/homelab" \
  "$HOME/.config/containers/systemd" \
  "$state/atuin.sqlite3" \
  "$state/server.toml" \
  "$state"/*.dump \
  "$HOME/.local/share/karakeep/data" \
  "$HOME/.local/bin/backup-wsl" \
  "$HOME/.config/systemd/user/backup.service" \
  "$HOME/.config/systemd/user/backup.timer"

# Container-owned app data needs the rootless user namespace to be readable; restore it with `podman unshare restic restore`.
data="$HOME/.local/share"
podman unshare restic backup --host fedora-pc --tag homelab-apps \
  "$data/actual" "$data/mealie" "$data/freshrss" "$data/logseq-sync" "$data/gatus" \
  "$data/activepieces/cache" "$data/activepieces/redis" \
  "$data/paperless/data" "$data/paperless/media" "$data/paperless/consume" "$data/paperless/export" \
  "$data/adventurelog/media"
