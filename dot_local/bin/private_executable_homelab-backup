#!/bin/bash
set -euo pipefail
export PATH=/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin
umask 077
. "$HOME/.config/restic/homelab.env"

state="$HOME/.local/share/homelab-backup"
mkdir -p "$state"
# shortcut: SIGKILL leaves this lock behind; verify no backup is running before removing it.
if ! mkdir "$state/lock" 2>/dev/null; then
  echo "Backup already running, or stale lock: $state/lock" >&2
  exit 1
fi
stage="$state/snapshot"
stopped=()
vm() { podman machine ssh "$@"; }
report_backup() {
  local token
  token=$(podman secret inspect --showsecret --format '{{.SecretData}}' gatus_push_token) || return
  printf 'header = "Authorization: Bearer %s"\n' "$token" |
    curl --fail --silent --show-error --retry 2 --retry-connrefused --retry-delay 2 --max-time 10 \
      --config - --request POST --output /dev/null \
      "http://127.0.0.1:9080/api/v1/endpoints/backups_nightly-backup/external?success=$1"
}
restart_services() {
  local i failed=0
  for ((i=${#stopped[@]}-1; i>=0; i--)); do
    vm "systemctl --user start ${stopped[$i]}" || failed=1
  done
  [ "$failed" -eq 0 ] || return 1
  stopped=()
}
cleanup() {
  local status=$?
  trap - EXIT
  restart_services || status=1
  rm -rf "$stage"
  rmdir "$state/lock"
  if [ "$status" -eq 0 ]; then
    report_backup true || echo 'Could not report backup success to Gatus' >&2
  else
    report_backup false || echo 'Could not report backup failure to Gatus' >&2
  fi
  echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') backup exit=$status"
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
mkdir "$stage"
echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') backup starting"
if [ "$(podman machine inspect --format '{{.State}}' podman-machine-default)" != running ]; then
  podman machine start podman-machine-default
fi

# Quiesce writers before copying SQLite and Redis persistence; leave PostgreSQL online for pg_dump.
for service in gatus.service activepieces.service logseq-sync.service activepieces-redis.service adventurelog.service actual.service; do
  if vm "systemctl --user is-active --quiet $service"; then
    stopped+=("$service")
    vm "systemctl --user stop $service"
  fi
done
for app in hindsight activepieces; do
  podman exec "$app-postgres" pg_dump -U "$app" -d "$app" -Fc > "$stage/$app.dump"
  test -s "$stage/$app.dump"
  podman exec -i "$app-postgres" sh -c 'pg_restore --list; status=$?; cat > /dev/null; exit "$status"' < "$stage/$app.dump" > /dev/null
done
podman exec adventurelog-db pg_dump -U adventure -d database -Fc > "$stage/adventurelog.dump"
test -s "$stage/adventurelog.dump"
podman exec -i adventurelog-db sh -c 'pg_restore --list; status=$?; cat > /dev/null; exit "$status"' < "$stage/adventurelog.dump" > /dev/null
vm 'podman unshare tar -czf - -C ~/.local/share logseq-sync activepieces/redis gatus adventurelog/media actual' > "$stage/app-data.tar.gz"
vm 'tar -czf - -C ~/.config/containers systemd' > "$stage/vm-quadlets.tar.gz"
gzip -t "$stage/app-data.tar.gz" "$stage/vm-quadlets.tar.gz"
secret_names=$(podman secret ls --format '{{.Name}}')
test -n "$secret_names"
podman secret inspect --showsecret $secret_names > "$stage/podman-secrets.json"
test -s "$stage/podman-secrets.json"
(cd "$stage" && shasum -a 256 *.dump *.gz podman-secrets.json > SHA256SUMS)
restart_services

restic backup --host n3o-macmini.local --tag homelab \
  "$stage" "$HOME/.config/homelab" "$HOME/.config/restic" \
  "$HOME/.local/bin/homelab-backup"
restic forget --host n3o-macmini.local --tag homelab --group-by host,tags \
  --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --prune
if [ "$(date +%u)" -eq 7 ]; then
  restic check --read-data-subset=5%
fi
