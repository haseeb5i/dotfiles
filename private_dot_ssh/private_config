Host github.com
    User git
    HostName github.com
    ServerAliveInterval 30
    IdentityFile ~/.ssh/github

Host pc
    HostName n3o-pc1.tail211f3.ts.net
    User haseeb

Host pc-warp
    HostName ssh-pc.ravennest.link
    User haseeb
    ProxyCommand /opt/homebrew/bin/cloudflared access ssh --hostname %h

Host wsl
    ProxyJump pc

Host wsl-warp
    ProxyJump pc-warp

Host wsl wsl-warp
    HostName 127.0.0.1
    Port 2222
    User raven

Host macbook
    HostName haseebs-macbook-pro.tail211f3.ts.net
    User raven

Host mini
    HostName n3os-mac-mini.tail211f3.ts.net
    User raven

Host macbook mini pc pc-warp wsl wsl-warp
    IdentityFile ~/.ssh/machines
    IdentitiesOnly yes
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m
    ServerAliveInterval 15
    ServerAliveCountMax 3
